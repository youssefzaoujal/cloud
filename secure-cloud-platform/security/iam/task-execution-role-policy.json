{
  "_comment": "ECS task EXECUTION role for orders-service. Used by the ECS agent to pull the image and write logs — never used by application code. Scoped to one repository and one log group.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullOrdersServiceImage",
      "Effect": "Allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:eu-west-1:ACCOUNT_ID:repository/secure-platform/orders-service"
    },
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "WriteOrdersServiceLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-1:ACCOUNT_ID:log-group:/ecs/secure-platform/orders-service:*"
    },
    {
      "Sid": "ReadOrdersServiceSecretAtStartup",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-west-1:ACCOUNT_ID:secret:secure-platform/orders-service/*"
    },
    {
      "Sid": "DecryptWithPlatformCmk",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-west-1:ACCOUNT_ID:key/PLATFORM_CMK_ID",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.eu-west-1.amazonaws.com"
        }
      }
    }
  ]
}
